# =====================================================================
# Git Ignore Configuration for Radio & TV Story Segmenter
# =====================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution, packaging, and frozen binaries
build/
dist/
.snapshots/
.archive/
*.egg-info/
*.spec
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Python virtual environments
venv/
.venv/
env/
ENV/

# Runtime diagnostics, logs, and local databases
*.log
*.sqlite3

# Operating System metadata
.DS_Store
Thumbs.db
Desktop.ini

# Environment variables & local secrets
.env*
!.env.example
.env.local
.env.*.local

# =====================================================================
# AI Studio Web Preview Scaffolding & Dependencies
# =====================================================================
node_modules/
.vite/
coverage/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock
